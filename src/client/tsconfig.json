{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "baseUrl": ".",
    "outDir": "../../dist",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "target": "es2022",
    "types": [
      "vitest/globals",
      "@testing-library/jest-dom"
    ],
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "./vitest.setup.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}

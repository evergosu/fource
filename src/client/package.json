{
  "name": "client",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.8.0"
  },
  "scripts": {
    "build": "pnpm build:next && pnpm build:express",
    "build:config": "tsc --noEmit -p tsconfig.next.json && esbuild config/next.config.ts --bundle --platform=node --format=esm --packages=external --allow-overwrite --banner:js='// This file is autogenerated, see: ./config/next.config.ts\n//@ts-nocheck' --outfile=next.config.js",
    "build:express": "tsc --noEmit && tsx ./build.ts && pnpm succeed:build:express",
    "build:next": "rm -rf .next && pnpm build:config && next build && pnpm succeed:build:next",
    "build:production": "NODE_ENV=production pnpm lint && pnpm build && pnpm test:once",
    "launch": "pnpm build:production && pnpm start:production",
    "launch:daemon": "pnpm build:production && pnpm start:production:daemon",
    "lint": "pnpm lint:code && pnpm lint:styles && pnpm lint:gherkin && pnpm succeed:lint",
    "lint:code": "tsc --noEmit --pretty -p tsconfig.json && eslint --fix",
    "lint:gherkin": "gherkin-lint -c ../../.gherkin-lintrc",
    "lint:styles": "stylelint '**/*.css' --fix",
    "logs:install": "[ \"$(pm2 id pm2-logrotate)\" = \"[0]\" ] || pm2 install pm2-logrotate",
    "logs:setup": "pm2 conf pm2-logrotate '{\"max_size\": \"10M\", \"retain\": 7, \"compress\": true, \"interval\": \"1d\"}'",
    "logs:start": "pm2 start pm2-logrotate",
    "logs:stop": "pm2 stop pm2-logrotate",
    "pre-commit": "lint-staged && pnpm test:changed",
    "start": "pnpm build:config && NODE_ENV=development tsx watch --clear-screen=false ./src/index.ts",
    "start:production": "NODE_ENV=production node ./dist/index.js",
    "start:production:daemon": "pnpm logs:install && pnpm logs:setup && pnpm logs:start && pm2 start ecosystem.config.cjs && pnpm succeed:launch",
    "succeed:build:express": ": '\u001b[1;32m✔ express build succeed\u001b[0m'",
    "succeed:build:next": ": '\u001b[1;32m✔ next build succeed\u001b[0m'",
    "succeed:launch": ": '\u001b[1;32m✔ launch succeed\u001b[0m'",
    "succeed:lint": ": '\u001b[1;32m✔ lint succeed\u001b[0m'",
    "succeed:test": ": '\u001b[1;32m✔ test succeed\u001b[0m'",
    "test": "NODE_ENV=test pnpm lint:gherkin && vitest watch",
    "test:changed": "NODE_ENV=test pnpm lint:gherkin && vitest run --changed && pnpm succeed:test",
    "test:once": "NODE_ENV=test pnpm lint:gherkin && vitest run && pnpm succeed:test"
  },
  "lint-staged": {
    "*.css": "pnpm lint:styles",
    "*.{ts,tsx}": "pnpm lint:code",
    "*.feature": "pnpm lint:gherkin"
  },
  "dependencies": {
    "@next/env": "^15.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "env-var": "^7.5.0",
    "esbuild": "^0.25.4",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "globby": "^14.1.0",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.5",
    "library": "workspace:*",
    "morgan": "^1.10.0",
    "next": "15.1.5",
    "pm2": "^6.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.3.0"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^4.7.0",
    "@eslint/compat": "^1.2.5",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@next/eslint-plugin-next": "^14.2.23",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/cors": "^2.8.18",
    "@types/eslint": "^9.6.1",
    "@types/eslint-plugin-jsx-a11y": "^6.9.0",
    "@types/eslint__eslintrc": "^2.1.2",
    "@types/eslint__js": "^8.42.3",
    "@types/express": "^4.17.22",
    "@types/http-proxy": "^1.17.16",
    "@types/jest": "^29.5.13",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.7.4",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/expect": "^2.1.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.13",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import-x": "^4.3.1",
    "eslint-plugin-jest-dom": "^5.4.0",
    "eslint-plugin-jsdoc": "^50.3.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-perfectionist": "^3.7.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^7.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-regexp": "^2.6.0",
    "eslint-plugin-sonarjs": "^2.0.3",
    "eslint-plugin-testing-library": "^6.3.0",
    "eslint-plugin-unicorn": "^55.0.0",
    "eslint-plugin-vitest": "^0.5.4",
    "gherkin-lint": "^4.2.4",
    "globals": "^15.9.0",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.5.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "stylelint": "^16.9.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-prettier": "^5.0.2",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^5.4.18",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.1"
  }
}

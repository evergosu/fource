{
  "name": "library",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.8.0"
  },
  "scripts": {
    "build": "tsc && pnpm succeed:build",
    "build:production": "NODE_ENV=production pnpm lint && pnpm build && pnpm test:once",
    "lint": "pnpm lint:code && pnpm lint:gherkin && pnpm succeed:lint",
    "lint:tsc": "tsc --noEmit --pretty -p tsconfig.json",
    "lint:code": "pnpm lint:tsc && eslint --fix",
    "lint:gherkin": "gherkin-lint -c ../../.gherkin-lintrc",
    "pre-commit": "pnpm lint:tsc && lint-staged && pnpm test:changed",
    "start": "NODE_ENV=development tsc --watch",
    "succeed:build": ": '\u001b[1;32m✔ build succeed\u001b[0m'",
    "succeed:lint": ": '\u001b[1;32m✔ lint succeed\u001b[0m'",
    "succeed:test": ": '\u001b[1;32m✔ test succeed\u001b[0m'",
    "test": "NODE_ENV=test pnpm lint:gherkin && vitest watch",
    "test:changed": "NODE_ENV=test pnpm lint:gherkin && vitest run --changed && pnpm succeed:test",
    "test:once": "NODE_ENV=test pnpm lint:gherkin && vitest run && pnpm succeed:test"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.feature": "pnpm lint:gherkin"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "env-var": "^7.5.0",
    "esbuild": "^0.25.4",
    "globby": "^14.1.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^4.7.0",
    "@eslint/compat": "^1.2.5",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@types/eslint": "^9.6.1",
    "@types/eslint__js": "^8.42.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import-x": "^4.3.1",
    "eslint-plugin-n": "^17.10.3",
    "eslint-plugin-perfectionist": "^3.7.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^7.1.0",
    "eslint-plugin-regexp": "^2.6.0",
    "eslint-plugin-sonarjs": "^2.0.3",
    "eslint-plugin-unicorn": "^55.0.0",
    "eslint-plugin-vitest": "^0.5.4",
    "gherkin-lint": "^4.2.4",
    "globals": "^15.9.0",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.5.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.1"
  }
}

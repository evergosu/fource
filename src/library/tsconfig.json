{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["es2023"],
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "library/*": [ "./src/*" ]
    },
    "outDir": "dist",
    "target": "es2022",
    "types": [
      "node",
      "vitest/globals"
    ],
    "typeRoots": [
      "./node_modules",
      "./node_modules/@types",
      "./src/types"
    ],
  },
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node",
  },
  "include": [ "src" ],
  "exclude": [ "node_modules", "dist" ],
}

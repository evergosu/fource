{
  "name": "server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.8.0"
  },
  "scripts": {
    "build": "tsc --noEmit && tsx ./build.ts && pnpm succeed:build",
    "build:production": "NODE_ENV=production pnpm lint && pnpm build && pnpm test:once",
    "database:daemon": "docker compose --ansi=always up",
    "database:generate": "NODE_ENV=development drizzle-kit generate",
    "database:migrate": "NODE_ENV=development drizzle-kit migrate",
    "database:push": "NODE_ENV=development drizzle-kit push",
    "database:seed": "NODE_ENV=development tsx -e \"import('./src/infrastructure/database/clients/postgresql').then(m => m.seed())\" && pnpm succeed:seed",
    "database:start": "bash -c 'trap \"docker compose --ansi=always down; docker network prune --force; kill 0\" SIGINT SIGTERM; pnpm database:daemon'",
    "database:stop": "docker compose --ansi=always down",
    "database:studio": "NODE_ENV=development drizzle-kit studio",
    "database:update": "pnpm database:generate && pnpm database:migrate && pnpm succeed:migration",
    "launch": "pnpm build:production && pnpm start:production",
    "launch:daemon": "pnpm build:production && pnpm start:production:daemon",
    "launch:daemon:database": "pnpm database:daemon & pnpm build:production && pnpm start:production:daemon",
    "launch:database": "pnpm database:start & pnpm build:production && pnpm start:production",
    "lint": "pnpm lint:code && pnpm lint:gherkin && pnpm succeed:lint",
    "lint:tsc": "tsc --noEmit --pretty -p tsconfig.json",
    "lint:code": "pnpm lint:tsc && eslint --fix",
    "lint:gherkin": "gherkin-lint -c ../../.gherkin-lintrc",
    "logs:install": "[ \"$(pm2 id pm2-logrotate)\" = \"[0]\" ] || pm2 install pm2-logrotate",
    "logs:setup": "pm2 conf pm2-logrotate '{\"max_size\": \"10M\", \"retain\": 7, \"compress\": true, \"interval\": \"1d\"}'",
    "logs:start": "pm2 start pm2-logrotate",
    "logs:stop": "pm2 stop pm2-logrotate",
    "pre-commit": "pnpm lint:tsc && lint-staged && pnpm test:changed",
    "start": "NODE_ENV=development tsx watch --clear-screen=false ./src/bootstrap/servers/node-postgresql.ts",
    "start:pglite": "NODE_ENV=development tsx watch --clear-screen=false ./src/bootstrap/servers/node-pglite.ts",
    "start:production": "NODE_ENV=production node ./dist/index.js",
    "start:production:daemon": "pnpm logs:install && pnpm logs:setup && pnpm logs:start && pm2 start ecosystem.config.cjs && pnpm succeed:launch",
    "succeed:build": ": '\u001b[1;32m✔ build succeed\u001b[0m'",
    "succeed:launch": ": '\u001b[1;32m✔ launch succeed\u001b[0m'",
    "succeed:lint": ": '\u001b[1;32m✔ lint succeed\u001b[0m'",
    "succeed:migration": ": '\u001b[1;32m✔ migration succeed\u001b[0m'",
    "succeed:seed": ": '\u001b[1;32m✔ seed succeed\u001b[0m'",
    "succeed:test": ": '\u001b[1;32m✔ test succeed\u001b[0m'",
    "test": "NODE_ENV=test pnpm lint:gherkin && vitest watch",
    "test:changed": "NODE_ENV=test pnpm lint:gherkin && vitest run --changed && pnpm succeed:test",
    "test:once": "NODE_ENV=test pnpm lint:gherkin && vitest run && pnpm succeed:test"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.feature": "pnpm lint:gherkin"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.1",
    "@faker-js/faker": "^9.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.43.1",
    "drizzle-zod": "^0.7.1",
    "env-var": "^7.5.0",
    "esbuild": "^0.25.4",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "globby": "^14.1.0",
    "helmet": "^8.0.0",
    "library": "workspace:*",
    "morgan": "^1.10.0",
    "pg": "^8.15.6",
    "pm2": "^6.0.6",
    "uuid": "^11.1.0",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^4.7.0",
    "@eslint/compat": "^1.2.5",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@types/cors": "^2",
    "@types/eslint": "^9.6.1",
    "@types/eslint__js": "^8.42.3",
    "@types/express": "^4",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.12.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-import-x": "^4.3.1",
    "eslint-plugin-jsdoc": "^50.7.1",
    "eslint-plugin-n": "^17.10.3",
    "eslint-plugin-perfectionist": "^3.7.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^7.1.0",
    "eslint-plugin-regexp": "^2.6.0",
    "eslint-plugin-sonarjs": "^2.0.3",
    "eslint-plugin-unicorn": "^55.0.0",
    "eslint-plugin-vitest": "^0.5.4",
    "gherkin-lint": "^4.2.4",
    "globals": "^15.9.0",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.5.1",
    "prettier": "^3.3.3",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.1"
  }
}

{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "esnext"],
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "outDir": "dist",
    "paths": {
      "client/*": ["../client/*"],
      "server/*": ["../server/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "target": "es2022",
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "references": [
    { "path": "../client" },
    { "path": "../server" }
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx",
  ],
  "exclude": ["node_modules", "dist"]
}

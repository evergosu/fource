{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "esnext"],
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "outDir": "dist",
    "paths": {
      "client/*": ["../client/src/*"],
      "server/*": ["../server/src/*"],
      "tests/*": [ "./src/*" ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "target": "es2022",
    "types": [
      "node",
      "vitest/globals",
      "@testing-library/jest-dom"
    ],
    "typeRoots": [
      "./node_modules",
      "./node_modules/@types",
      "./src/lib/types"
    ],
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "./src/lib/types/environment.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}

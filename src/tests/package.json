{
  "name": "tests",
  "private": true,
  "type": "module",
  "scripts": {
    "build:production": "NODE_ENV=production pnpm lint && pnpm test:once && pnpm succeed:acceptance",
    "launch": "pnpm build:production",
    "launch:daemon": "pnpm build:production",
    "launch:daemon:database": "pnpm build:production",
    "launch:database": "pnpm build:production",
    "lint": "pnpm lint:code && pnpm lint:gherkin && pnpm succeed:lint",
    "lint:code": "tsc --noEmit --pretty -p tsconfig.json && eslint --fix",
    "lint:gherkin": "gherkin-lint -c ../../.gherkin-lintrc",
    "pre-commit": "lint-staged && pnpm test:changed",
    "succeed:acceptance": ": '\u001b[1;32m✔ acceptance criteria succeed\u001b[0m'",
    "succeed:lint": ": '\u001b[1;32m✔ lint succeed\u001b[0m'",
    "succeed:test": ": '\u001b[1;32m✔ test succeed\u001b[0m'",
    "test": "NODE_ENV=test pnpm lint:gherkin && vitest watch",
    "test:changed": "NODE_ENV=test pnpm lint:gherkin && vitest run --changed && pnpm succeed:test",
    "test:once": "NODE_ENV=test pnpm lint:gherkin && vitest run && pnpm succeed:test"
  },
  "lint-staged": {
    "*.{ts,tsx}": "pnpm lint:code",
    "*.feature": "pnpm lint:gherkin"
  },
  "dependencies": {
    "@amiceli/vitest-cucumber": "^4.7.0",
    "@testing-library/react": "^16.2.0",
    "client": "workspace:*",
    "dotenv": "^16.5.0",
    "env-var": "^7.5.0",
    "next": "15.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server": "workspace:*",
    "swr": "^2.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.1",
    "@eslint/compat": "^1.2.5",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@next/eslint-plugin-next": "^14.2.23",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/eslint": "^9.6.1",
    "@types/eslint-plugin-jsx-a11y": "^6.9.0",
    "@types/eslint__eslintrc": "^2.1.2",
    "@types/eslint__js": "^8.42.3",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.4",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/expect": "^2.1.1",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.1",
    "drizzle-orm": "^0.43.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.13",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import-x": "^4.3.1",
    "eslint-plugin-jest-dom": "^5.4.0",
    "eslint-plugin-jsdoc": "^50.3.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-perfectionist": "^3.7.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^7.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-regexp": "^2.6.0",
    "eslint-plugin-sonarjs": "^2.0.3",
    "eslint-plugin-testing-library": "^6.3.0",
    "eslint-plugin-unicorn": "^55.0.0",
    "eslint-plugin-vitest": "^0.5.4",
    "gherkin-lint": "^4.2.4",
    "globals": "^15.9.0",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.5.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "stylelint": "^16.9.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-prettier": "^5.0.2",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^5.4.18",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.9"
  }
}
